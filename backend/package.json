{
  "name": "swapnajatra-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API + admin CMS backend for Swapnajatra Properties Ltd.",
  "main": "src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo",
    "setup": "node scripts/migrate.js && node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.14"
  }
}
