# Copy to .env and fill in. NEVER commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://swapnajatra:CHANGE_ME@localhost:5432/swapnajatra
# false = local DB, true = managed DB with TLS (Render/Railway/Neon/Supabase), strict = also verify the certificate
DATABASE_SSL=false

# Long random string (>= 32 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Admin session lifetime after last activity (hours)
SESSION_MAX_HOURS=8

# Production only (HTTPS required):
#   COOKIE_SECURE=true   TRUST_PROXY=1 (number of reverse proxies in front, e.g. Render/Nginx)
COOKIE_SECURE=false
TRUST_PROXY=

# Extra browser origins allowed to call the API (comma separated). Leave empty when the backend serves the website.
CORS_ORIGINS=

# Image uploads (stored on disk; the DB keeps only the URL). In production point to a PERSISTENT volume.
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_MB=5

# Optional e-mail notifications / auto-reply (Settings > Lead settings). Leave empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Swapnajatra Properties <no-reply@yourdomain.com>"
